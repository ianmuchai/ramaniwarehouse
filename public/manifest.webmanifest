{
  "id": "/",
  "name": "Ramani Warehouse",
  "short_name": "Ramani",
  "description": "Install Ramani Warehouse to browse materials, estimate product needs, and place orders from your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#fff8ef",
  "theme_color": "#101820",
  "orientation": "portrait-primary",
  "categories": ["shopping", "business", "productivity"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/ramani-icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/ramani-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/ramani-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Shop categories",
      "short_name": "Shop",
      "description": "Browse Ramani product departments.",
      "url": "/categories",
      "icons": [{ "src": "/icons/ramani-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open estimator",
      "short_name": "Estimator",
      "description": "Create a product-aware sourcing estimate.",
      "url": "/estimator",
      "icons": [{ "src": "/icons/ramani-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Request quote",
      "short_name": "Quote",
      "description": "Send Ramani a quote request.",
      "url": "/contact",
      "icons": [{ "src": "/icons/ramani-icon-192.png", "sizes": "192x192" }]
    }
  ]
}